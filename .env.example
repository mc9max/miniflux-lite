# Miniflux Lite — Environment Variables
# Copy to .env and fill in your values

# Database (auto-wired from Postgres companion — do NOT set manually in Railway)
DATABASE_URL=postgres://miniflux:miniflux-pass@postgres:5432/miniflux?sslmode=disable

# Admin account (first run only)
RUN_MIGRATIONS=1
CREATE_ADMIN=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-12-chars

# Public URL (auto-wired from Railway)
BASE_URL=https://your-domain.up.railway.app

# Feed fetching
POLLING_FREQUENCY=60
BATCH_SIZE=100

# Optional: webhook for new entries (e.g., Marketing Bot)
MINIFLUX_WEBHOOK_URL=
